if (location.pathname == "/new_order") {
  delivery_variants.onclick = function() {

    setTimeout(function () {
      if ($("input#order_delivery_variant_id_1429810").attr('checked') == "checked") {
        $("#shipping_address_address").val($("#delivery_description_1429810").val())
      }
    }, 100);
  };
};

