<!DOCTYPE html>
<html>
  <head>
    {% include "head" %}

    {% include "styles" %}
  </head>

  <body class="fhg-body">
    {% include "no_js_alert" %}

    <div class="top-panel-wrapper">
      <div class="container">
        {% include "top_panel" %}
      </div>
    </div>

    <div class="header-wrapper">
      <div class="container">
        {% include "header" %}
      </div>
    </div>

    <div class="catalog-menu-wrapper hidden-sm">
      <div class="container">
        {% include "menu", source_type: 'collection', source_handle: 'all', menu_class: 'catalog-menu', show_icon: false %}
      </div>
    </div>

    <div class="content-wrapper container fhg-content">
      {% assign content_classes = 'cell-9 cell-8-md cell-12-sm' %}
      {% assign sidebar_classes = 'cell-3 cell-4-md hidden-sm sineva' %}

      {% unless template contains 'collection' or template contains 'blog' or template contains 'article' %}
        {% assign content_classes = 'cell-12' %}
        {% assign sidebar_classes = '' %}
      {% endunless %}

      {% unless template contains 'index' %}
        {% include "breadcrumb", home_title: 'Главная' %}

        {% include "page_header" %}
      {% endunless %}

      {% assign sidebar_position = 'flex-last' %}
      {% if template contains 'collection' %}
        {% assign sidebar_position = 'flex-first' %}
      {% endif %}

      <div class="row {{ template }}-wrapper">
        <div class="{{ template }} {{ content_classes }}">
          {{ content_for_layout }}
        </div>

        {% unless sidebar_classes == '' %}
          <div class="{{ sidebar_classes }} {{ sidebar_position }}">
            {% include "sidebar" %}
          </div>
        {% endunless %}
      </div>
      {% if template contains 'index' %}
        {% include "page_header" %}

        <div class="index-description editor">
          {{ page.content | editable}}
        </div>
      {% endif %}
       {% if settings.use_recently_view %}
        {% include 'recently_view_slider' %}
      {% endif %}
    </div>

    <div class="footer-wrapper">
      <div class="container">
        {% include "footer" %}
      </div>
    </div>
{% comment %}
<script>
  $('button[data-item-add]').on('click', function() {
    setTimeout(function() {
      window.location.href='/cart_items';
    }, 200);
  });
</script>
{% endcomment %}
    {% include "popup" %}
  </body>

  {% include "modals" %}
  {% include "scripts" %}
</html>
